
"""
Modularity on the Karate Club Graph (DSC212).
Ref: Newman (2006), PNAS 103(23):8577-8582.
"""

import numpy as np
import networkx as nx
import matplotlib.pyplot as plt
import pandas as pd

np.set_printoptions(precision=4, suppress=True)
plt.rcParams["figure.dpi"] = 100

# 1. Load graph and build adjacency and modularity matrices

G = nx.karate_club_graph()
n, m = G.number_of_nodes(), G.number_of_edges()
nodes = list(range(n))

A = nx.to_numpy_array(G, nodelist=nodes, weight=None)
k = A.sum(axis=1)
B = A - np.outer(k, k) / (2 * m)

print(f"n = {n}, m = {m}")
print("A symmetric:", np.allclose(A, A.T))
print("B symmetric:", np.allclose(B, B.T))
print("sum of degrees = 2m:", k.sum() == 2 * m)
print("B @ 1 == 0:", np.allclose(B @ np.ones(n), 0))

true_label = np.array([
    1 if G.nodes[i]["club"] == "Mr. Hi" else -1
    for i in nodes
])

print("Ground truth sizes:",
      (true_label == 1).sum(),
      (true_label == -1).sum())


# 2. Modularity score and spectral bipartition

EIG_TOL = 1e-10


def modularity(partition, B, m):
    return sum(
        B[np.ix_(c, c)].sum()
        for c in partition
    ) / (2 * m)


def restricted_B(B, C, use_newman_correction=False):
    idx = np.asarray(sorted(C), dtype=int)
    BC = B[np.ix_(idx, idx)].copy()

    if use_newman_correction:
        BC -= np.diag(BC.sum(axis=1))

    return idx, BC


def leading_eigenpair(M):
    w, V = np.linalg.eigh(M)
    return w[-1], V[:, -1]


def spectral_bipartition(
    B, C, use_newman_correction=False
):
    idx, BC = restricted_B(
        B, C, use_newman_correction
    )

    if len(idx) < 2:
        return 0.0, None, None

    lam1, u1 = leading_eigenpair(BC)

    if lam1 <= EIG_TOL:
        return lam1, None, None

    s = np.where(u1 > 0, 1, -1)

    if np.all(s == 1) or np.all(s == -1):
        return lam1, None, None

    return (
        lam1,
        idx[s == 1].tolist(),
        idx[s == -1].tolist()
    )


# 3. Recursive bisection

def recursive_bisection(
    B, m, use_newman_correction=False, verbose=True
):
    n = B.shape[0]

    partition = [list(range(n))]

    history = [
        dict(
            iteration=0,
            partition=[c[:] for c in partition],
            Q=modularity(partition, B, m),
            split=None,
            lam1=None
        )
    ]

    queue = [list(range(n))]
    final = []
    it = 0

    while queue:
        C = queue.pop(0)

        lam1, Cp, Cm = spectral_bipartition(
            B, C, use_newman_correction
        )

        if Cp is None:
            final.append(C)

            if verbose:
                print(
                    f"Community of size {len(C)} "
                    f"is indivisible (lambda1={lam1:+.4f})"
                )
            continue

        it += 1

        partition = [
            c for c in partition
            if sorted(c) != sorted(C)
        ] + [Cp, Cm]

        Q = modularity(partition, B, m)

        history.append(
            dict(
                iteration=it,
                partition=[sorted(c) for c in partition],
                Q=Q,
                split=(sorted(C), sorted(Cp), sorted(Cm)),
                lam1=lam1
            )
        )

        if verbose:
            print(
                f"Iteration {it}: "
                f"split size {len(C)} -> "
                f"{len(Cp)} + {len(Cm)}, "
                f"Q={Q:.4f}"
            )

        queue += [Cp, Cm]

    return history, [sorted(c) for c in final]


history, final_communities = recursive_bisection(
    B, m, use_newman_correction=False
)

print("\nFinal communities:")

for i, c in enumerate(
    sorted(final_communities, key=lambda c: c[0])
):
    print(f"C{i+1} (size {len(c)}): {c}")

print(
    f"\nFinal modularity Q = {history[-1]['Q']:.4f}"
)


# Compare first split with the actual club split

first_split = history[1]["split"]

pred = np.zeros(n, dtype=int)
pred[first_split[1]] = 1
pred[first_split[2]] = -1

acc = max(
    (pred == true_label).mean(),
    (pred == -true_label).mean()
)

aligned = (
    true_label
    if (pred == true_label).mean() >= 0.5
    else -true_label
)

wrong = [
    i for i in nodes
    if pred[i] != aligned[i]
]

print(
    f"First spectral split accuracy: {acc*100:.1f}%"
)
print("Misclassified nodes:", wrong)


# 4. Visualization after each split

pos = nx.spring_layout(G, seed=42)
palette = plt.get_cmap("tab10").colors


def community_colors(partition):
    ordered = sorted(partition, key=lambda c: min(c))
    color_of = {}

    for ci, c in enumerate(ordered):
        for v in c:
            color_of[v] = palette[ci % len(palette)]

    return [color_of[v] for v in nodes]


def draw_partition(partition, title, ax=None):
    ax = ax or plt.gca()

    nx.draw_networkx_edges(
        G, pos, alpha=0.4, ax=ax
    )

    nx.draw_networkx_nodes(
        G,
        pos,
        node_color=community_colors(partition),
        node_size=330,
        edgecolors="black",
        linewidths=0.6,
        ax=ax
    )

    nx.draw_networkx_labels(
        G, pos, font_size=8, ax=ax
    )

    ax.set_title(title)
    ax.axis("off")


for h in history:
    fig, ax = plt.subplots(figsize=(7, 6))

    label = (
        "Iteration 0: whole graph (1 community)"
        if h["iteration"] == 0
        else
        f"Iteration {h['iteration']}: "
        f"{len(h['partition'])} communities, "
        f"Q={h['Q']:.3f}"
    )

    draw_partition(h["partition"], label, ax)
    plt.show()


# Ground truth visualization

fig, ax = plt.subplots(figsize=(7, 6))

draw_partition(
    [
        [i for i in nodes if true_label[i] == 1],
        [i for i in nodes if true_label[i] == -1]
    ],
    "Ground truth: Mr. Hi vs Officer",
    ax
)

plt.show()


# 5. Node metrics after each split

def community_graph(G, partition):
    label = {
        v: ci
        for ci, c in enumerate(partition)
        for v in c
    }

    H = nx.Graph()
    H.add_nodes_from(G.nodes())

    H.add_edges_from(
        (u, v)
        for u, v in G.edges()
        if label[u] == label[v]
    )

    return H


def compute_metrics(H):
    return {
        "Degree centrality":
            nx.degree_centrality(H),

        "Betweenness centrality":
            nx.betweenness_centrality(H),

        "Closeness centrality":
            nx.closeness_centrality(H),

        "Clustering coefficient":
            nx.clustering(H)
    }


metric_names = [
    "Degree centrality",
    "Betweenness centrality",
    "Closeness centrality",
    "Clustering coefficient"
]


metrics_by_iter = {}

for h in history:
    H = community_graph(G, h["partition"])

    metrics_by_iter[h["iteration"]] = (
        compute_metrics(H)
    )

iters = sorted(metrics_by_iter)


# Create metrics table

rows = []

for it_ in iters:
    for v in nodes:
        row = {
            "iteration": it_,
            "node": v
        }

        for mn in metric_names:
            row[mn] = metrics_by_iter[it_][mn][v]

        rows.append(row)

metrics_df = pd.DataFrame(rows)

print(metrics_df.head(10))


# Top five nodes for every metric

for mn in metric_names:
    print(f"\n=== {mn} ===")

    for it_ in iters:
        top = sorted(
            nodes,
            key=lambda v: -metrics_by_iter[it_][mn][v]
        )[:5]

        vals = ", ".join(
            f"{v} ({metrics_by_iter[it_][mn][v]:.3f})"
            for v in top
        )

        print(f"Iteration {it_}: {vals}")


# 6. Evolution of metrics across iterations

def plot_metric_evolution(mn, top_k=5):
    mat = np.array([
        [
            metrics_by_iter[it_][mn][v]
            for it_ in iters
        ]
        for v in nodes
    ])

    top = np.argsort(-mat.mean(axis=1))[:top_k]

    fig, ax = plt.subplots(figsize=(9, 5))

    for v in nodes:
        if v not in top:
            ax.plot(
                iters,
                mat[v],
                color="lightgrey",
                lw=1,
                zorder=1
            )

    for ci, v in enumerate(top):
        ax.plot(
            iters,
            mat[v],
            marker="o",
            lw=2.2,
            color=palette[ci],
            label=f"Node {v}",
            zorder=3
        )

    ax.set_xticks(iters)
    ax.set_xlabel("Iteration (number of splits performed)")
    ax.set_ylabel(mn)
    ax.set_title(
        f"{mn} across iterations "
        f"(top {top_k} nodes highlighted)"
    )

    ax.legend(ncol=2, fontsize=9)
    ax.grid(alpha=0.3)

    plt.tight_layout()
    plt.show()


for mn in metric_names:
    plot_metric_evolution(mn)


# Heatmaps for all metrics

fig, axes = plt.subplots(
    1, 4,
    figsize=(18, 8),
    sharey=True
)

for ax, mn in zip(axes, metric_names):
    mat = np.array([
        [
            metrics_by_iter[it_][mn][v]
            for it_ in iters
        ]
        for v in nodes
    ])

    im = ax.imshow(
        mat,
        aspect="auto",
        cmap="viridis"
    )

    ax.set_title(mn, fontsize=10)

    ax.set_xticks(range(len(iters)))
    ax.set_xticklabels(iters)

    ax.set_xlabel("Iteration")

    ax.set_yticks(range(n))
    ax.set_yticklabels(nodes, fontsize=7)

    fig.colorbar(
        im,
        ax=ax,
        fraction=0.046,
        pad=0.04
    )

axes[0].set_ylabel("Node")

plt.tight_layout()
plt.show()


# 7. Compare handout and Newman correction

for flag in (False, True):
    h_, final_ = recursive_bisection(
        B,
        m,
        use_newman_correction=flag,
        verbose=False
    )

    name = (
        "Newman-corrected B(C)"
        if flag
        else "Handout block B(C)"
    )

    print(
        f"{name}: "
        f"{len(final_)} communities, "
        f"final Q={h_[-1]['Q']:.4f}, "
        f"sizes={sorted(len(c) for c in final_)}"
    )


# 8. Discussion and analysis

def mean_rank_table():
    out = {}

    for mn in metric_names:
        avg = pd.Series({
            v: np.mean([
                metrics_by_iter[it_][mn][v]
                for it_ in iters
            ])
            for v in nodes
        })

        out[mn] = avg.sort_values(
            ascending=False
        ).head(5)

    return out


for mn, s in mean_rank_table().items():
    print(
        f"{mn:24s} top-5 by mean over iterations -> "
        + ", ".join(
            f"{v} ({val:.3f})"
            for v, val in s.items()
        )
    )


# Nodes appearing in the degree centrality top 5
# at every iteration

def topset(mn, it_, k_=5):
    return set(
        sorted(
            nodes,
            key=lambda v: -metrics_by_iter[it_][mn][v]
        )[:k_]
    )


consistent = set(nodes)

for it_ in iters:
    consistent &= topset(
        "Degree centrality", it_
    )

print(
    "\nNodes in degree-centrality top-5 "
    "at every iteration:",
    sorted(consistent)
)


print("\nDISCUSSION")

print("""
Which nodes stay central?

Nodes 33 and 0 are the two hubs of the network.
Together with nodes 32 and 1, they remain among
the most important nodes in the network.

How community structure shapes the metrics:

1. Degree centrality:
Degree centrality can only fall as splits remove
cross-community edges.

2. Betweenness centrality:
Betweenness changes significantly because shortest
paths between factions disappear after splitting.

3. Closeness centrality:
Closeness drops as the graph fragments because
nodes can reach only their own communities.

4. Clustering coefficient:
Clustering may increase when cross-community edges
are removed, revealing tighter groups.

Takeaway:

The first spectral split reproduces the real fission
of the club for 33 of 34 members.

Recursive bisection further divides the network
into smaller communities.

The hubs and bridging nodes play important roles
in determining the community structure.
""")


